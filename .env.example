# ---------------------------------------------------------------------------
# gemini-web2api - configuration via environment variables (no config.json)
# Copy to .env for local runs, or paste into Railway > Variables > Raw Editor.
# ---------------------------------------------------------------------------

# Cookie of gemini.google.com as ONE line (DevTools > Network > any request >
# Request Headers > Cookie). Leave empty to run in anonymous mode.
GEMINI_COOKIE=__Secure-1PSID=xxx; __Secure-1PSIDTS=xxx; SAPISID=xxx

# Only needed when SAPISID is not present inside GEMINI_COOKIE
# GEMINI_SAPISID=

# Client API keys, comma separated. Empty = no auth (not recommended in public).
API_KEYS=sk-gemini

# Server. Railway injects PORT automatically - do not set it there.
HOST=0.0.0.0
# PORT=8081

# Behaviour
DEFAULT_MODEL=gemini-3.6-flash
LOG_REQUESTS=true
TEMPORARY_CHATS=false

# Optional knobs (uncomment to override defaults)
# RETRY_ATTEMPTS=3
# RETRY_DELAY_SEC=2
# REQUEST_TIMEOUT_SEC=180
# GEMINI_BL=boq_assistant-bard-web-server_20260716.08_p0
# GEMINI_AUTH_USER=0
# GEMINI_XSRF_TOKEN=
# GEMINI_PROXY=http://127.0.0.1:7890
# GEMINI_COOKIE_FILE=
