{
  "manifest_version": 3,
  "name": "Gemini Cookie Sync",
  "version": "1.1",
  "description": "Exports Gemini cookies plus XSRF/build metadata for gemini-web2api, or pushes them to a running proxy.",
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Gemini Cookie Sync",
    "default_popup": "popup.html"
  }
}